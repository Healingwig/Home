# ============================================================================
#  Todo lo de aquí abajo puede funcionar sin pagar nada.
# ============================================================================

# --- Qué modelo genera la receta ----------------------------------------
# gemini    → capa gratuita de Google AI Studio. Sin tarjeta, sin hardware.
# ollama    → modelo local en tu ordenador. Gratis del todo y sin terceros.
# anthropic → Claude. De pago (~0,15 €/receta), la mejor calidad.
LLM_PROVIDER=gemini

# --- Opción gemini (gratis) ----------------------------------------------
# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Opción ollama (gratis) ----------------------------------------------
# Si Ollama corre en tu ordenador y la app en Docker, usa host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
# Con visión (lee el texto sobreimpreso del vídeo). Necesita ~8 GB de RAM.
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=900

# --- Opción anthropic (de pago) ------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=high

# --- Acceso ---------------------------------------------------------------
# Clave que usará el Atajo del iPhone. Aunque solo lo uses tú, ponla:
# genérala con  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia-esto-por-una-clave-larga
# Contraseña para entrar a la web desde la tablet (por defecto, la API_KEY).
APP_PASSWORD=una-contraseña-que-puedas-teclear
# Secreto para firmar la cookie de sesión (por defecto, la API_KEY).
SESSION_SECRET=

# --- Datos ----------------------------------------------------------------
DATA_DIR=/data

# --- Instagram ------------------------------------------------------------
# Muchos reels exigen sesión iniciada. Exporta las cookies de instagram.com
# en formato Netscape y apunta aquí al fichero. Ver docs/despliegue.md.
# IG_COOKIES_FILE=/data/cookies_instagram.txt
# IG_COOKIES_FROM_BROWSER=chrome

# --- Cómo se lee el vídeo -------------------------------------------------
RECIPE_LANGUAGE=español
# Fotogramas que ve el modelo. Con 0 solo se usan el texto del post y el audio
# (necesario si tu modelo local no entiende imágenes).
FRAME_COUNT=14
FRAME_MAX_DIM=1024

# --- Transcripción del audio (local y gratis) ----------------------------
# auto (usa Whisper si está instalado) | whisper | none
TRANSCRIBER=auto
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# --- Otros ----------------------------------------------------------------
WORKER_THREADS=2
MAX_VIDEO_SECONDS=900
KEEP_VIDEO=false
LOG_LEVEL=INFO
