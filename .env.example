# ============================================================================
#  Todo esto funciona dentro de capas gratuitas. Ver docs/despliegue.md.
# ============================================================================

# --- Modelo ---------------------------------------------------------------
# gemini    → capa gratuita de Google AI Studio. Recibe el vídeo entero.
# ollama    → modelo local en un ordenador tuyo. Gratis y sin terceros.
# anthropic → Claude. De pago.
LLM_PROVIDER=gemini
# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Acceso ---------------------------------------------------------------
# Clave que usará el Atajo del iPhone.
# Genérala con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia-esto-por-una-clave-larga
# Contraseña para entrar a la web desde la tablet (por defecto, la API_KEY).
APP_PASSWORD=una-contraseña-que-puedas-teclear
# Secreto para firmar la cookie de sesión (por defecto, la API_KEY).
SESSION_SECRET=

# --- Dónde se guardan las recetas ----------------------------------------
# local → ficheros en DATA_DIR (para ejecutarlo en tu equipo)
# gcs   → Google Cloud Storage (obligatorio en Cloud Run: no hay disco)
STORAGE_BACKEND=gcs
GCS_BUCKET=recetas-de-tu-nombre
GCS_PREFIX=recetario
DATA_DIR=/tmp/recetas

# --- Instagram ------------------------------------------------------------
# Muchos reels exigen sesión iniciada, y desde un centro de datos casi todos.
# Exporta las cookies de instagram.com en formato Netscape y pégalas aquí en
# base64 (base64 -w0 cookies.txt). Ver docs/despliegue.md.
IG_COOKIES_B64=
# Alternativa si tienes disco propio:
# IG_COOKIES_FILE=/data/cookies_instagram.txt

# --- Cómo se lee el vídeo -------------------------------------------------
RECIPE_LANGUAGE=español
# Con Gemini se manda el vídeo entero (imagen + audio en una sola pasada).
SEND_VIDEO=true
# Tamaño máximo del vídeo ya recomprimido, en bytes. Por encima se recorta la
# calidad; si aun así no cabe, se pasa a fotogramas sueltos.
VIDEO_MAX_BYTES=13631488
# Fotogramas para el modo de reserva (y para modelos que no aceptan vídeo).
FRAME_COUNT=14
FRAME_MAX_DIM=1024

# --- Transcripción local (solo con ollama o anthropic) -------------------
# Gemini no la necesita: escucha el audio del vídeo directamente.
TRANSCRIBER=auto
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# --- Opción ollama --------------------------------------------------------
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5vl:7b

# --- Otros ----------------------------------------------------------------
WORKER_THREADS=2
MAX_VIDEO_SECONDS=900
LOG_LEVEL=INFO
